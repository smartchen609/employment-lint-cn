{
  "name": "employment-lint-cn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "劳动关系操作预检 Linter — 纯前端、规则显式、结论不完备",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:strict",
    "build": "tsc --noEmit && vite build && npm run build:handbook",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-rules.ts",
    "validate:strict": "tsx scripts/validate-rules.ts --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run validate && npm run test",
    "build:content": "tsx scripts/build-content.ts",
    "audit:bundle": "tsx scripts/audit-bundle.ts",
    "test:mutation": "tsx scripts/mutation-test.ts",
    "check:full": "npm run check && npm run test:mutation && npm run build && npm run audit:bundle",
    "build:handbook": "tsx scripts/build-handbook.ts",
    "pretypecheck": "npm run build:content"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "markdown-it": "^15.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
}
